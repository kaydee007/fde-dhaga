# Copy to .env. Every value here is safe to leave as is for a local run.

# Leave empty to use SQLite built from csv/ (no database needed).
# Set to the team's Postgres (or Neon/Supabase) so corrections survive restarts:
#   DATABASE_URL=postgresql://user:password@host:5432/dhaga
DATABASE_URL=

# "synthetic" shows the test-data banner. Set to "real" only for real Dhaga data.
DATA_LABEL=synthetic

# Where the local SQLite copy is written.
DATA_DIR=var
